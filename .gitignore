# Secrets — never commit. .env holds API keys; .env.example is the safe template.
.env
.env.*
!.env.example

# Virtualenv and caches
.venv/
__pycache__/
*.pyc
*.pyo

# Built vector index — rebuildable from corpora/ with `python cli.py ingest`
.chroma/

# Documents uploaded through the UI. Not committed: they are whatever the user dropped in,
# may be confidential, and are not part of the app.
corpora/uploaded/

# macOS
.DS_Store
