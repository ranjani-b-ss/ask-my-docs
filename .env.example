# Copy to `.env` and fill in only what you use.  `.env` is gitignored — keys never get
# committed, and nothing in this app writes a key to disk or logs one.
#
#   cp .env.example .env
#
# The app runs with NONE of this set: it falls back to retrieval-only mode, which quotes
# the winning passage instead of writing prose. Retrieval, citations, and the refusal
# behaviour all still work, so the app is fully demonstrable with no key at all.

# ── Which model writes the final answer ───────────────────────────────────────────────
# ollama    local, free, offline, no key. Install Ollama, then `ollama pull llama3.1:8b`.
# openai    hosted, costs per call, needs OPENAI_API_KEY below.
# anthropic hosted, costs per call, needs ANTHROPIC_API_KEY below.
LLM_PROVIDER=ollama

# ── Keys (only the one matching LLM_PROVIDER is read) ─────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional model overrides ──────────────────────────────────────────────────────────
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-5

# ── Which model turns text into vectors ───────────────────────────────────────────────
# local   bge-small via ONNX. Free, offline, 384-dim. The default.
# openai  text-embedding-3-small. 1536-dim, costs money, needs OPENAI_API_KEY.
#
# Changing this builds a SEPARATE index — vectors from different models are not
# comparable, so the old one is left intact rather than corrupted. Re-run ingest after
# switching.
EMBED_PROVIDER=local

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.6-flash   # see the comment in src/config.py before using a
                                  # "-latest" alias instead — verify it live first

# OLLAMA_MODEL=llama3.2:3b   # 3b for CPU-only machines; llama3.1:8b if you have a GPU
